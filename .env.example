# EMIT Center LMS — Environment Variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# PostgreSQL (Neon, Supabase, RDS, etc.)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Stripe (payment processing)
# Get these from the Stripe Dashboard -> Developers -> API keys.
# Leave as placeholder values to run in demo/payment-less mode.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx

# Optional: override the password used when seeding demo users
# (defaults to ChangeMe123! if unset)
# SEED_PASSWORD="ChangeMe123!"
