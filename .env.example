# EMIT Center LMS — Environment Variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# PostgreSQL (Neon, Supabase, RDS, etc.)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Stripe (payment processing)
# Get these from the Stripe Dashboard -> Developers -> API keys.
# Leave as placeholder values to run in demo/payment-less mode.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx

# Stripe webhook signing secret (whsec_...) for automatic enrollment activation.
# Create a webhook in Stripe -> Developers -> Webhooks pointing at <APP_URL>/api/stripe/webhook
# You can also paste this in the admin dashboard under Payment Settings.
# STRIPE_WEBHOOK_SECRET=whsec_xxx

# Transactional email. Uses Resend (recommended) / SMTP / SendGrid as configured
# in the admin dashboard (Settings -> Email Delivery). These are fallbacks:
RESEND_API_KEY=re_xxx
MAIL_FROM="EMIT Center <no-reply@emitcenter.com>"

# File upload storage. Set to use Vercel Blob (managed); otherwise files are
# stored on the server under ./data/uploads.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx

# Public origin used to build verification / email links in production.
# NEXT_PUBLIC_APP_URL=https://emit-center-lms.vercel.app

# Optional: override the password used when seeding demo users
# (defaults to Root26 if unset)
# SEED_PASSWORD="Root26"
